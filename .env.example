# 공통
DATABASE_URL=postgresql://cote:cote@localhost:5432/cote
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Judge
# local  : 호스트 프로세스로 직접 실행 (개발 전용, 격리 없음)
# docker : 언어별 Docker 이미지에서 격리 실행 (운영)
JUDGE_EXECUTOR=local
JUDGE_CONCURRENCY=2
JUDGE_WORKDIR=.judge-tmp

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
