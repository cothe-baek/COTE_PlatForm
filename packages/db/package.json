{
  "name": "@cote/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "seed": "dotenv -e ../../.env -- prisma db seed",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2"
  },
  "devDependencies": {
    "prisma": "^6.16.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0",
    "dotenv-cli": "^8.0.0"
  }
}
